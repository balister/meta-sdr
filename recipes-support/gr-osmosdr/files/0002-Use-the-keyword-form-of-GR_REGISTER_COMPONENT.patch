@@ -196,7 +196,7 @@ endif(ENABLE_NONFREE)
 ########################################################################
 # Setup HackRF component
 ########################################################################
-GR_REGISTER_COMPONENT("HackRF & rad1o Badge" ENABLE_HACKRF LIBHACKRF_FOUND)
+GR_REGISTER_COMPONENT(NAME "HackRF & rad1o Badge" VAR ENABLE_HACKRF NO_INSTALL REQUIRED_TPLS LIBHACKRF_FOUND)
 if(ENABLE_HACKRF)
     add_subdirectory(hackrf)
 endif(ENABLE_HACKRF)
@@ -204,7 +204,7 @@ endif(ENABLE_HACKRF)
 ########################################################################
 # Setup bladeRF component
 ########################################################################
-GR_REGISTER_COMPONENT("nuand bladeRF" ENABLE_BLADERF LIBBLADERF_FOUND)
+GR_REGISTER_COMPONENT(NAME "nuand bladeRF" VAR ENABLE_BLADERF NO_INSTALL REQUIRED_TPLS LIBBLADERF_FOUND)
 if(ENABLE_BLADERF)
     add_subdirectory(bladerf)
 endif(ENABLE_BLADERF)
@@ -212,7 +212,7 @@ endif(ENABLE_BLADERF)
 ########################################################################
 # Setup RFSPACE component
 ########################################################################
-GR_REGISTER_COMPONENT("RFSPACE Receivers" ENABLE_RFSPACE)
+GR_REGISTER_COMPONENT(NAME "RFSPACE Receivers" VAR ENABLE_RFSPACE NO_INSTALL)
