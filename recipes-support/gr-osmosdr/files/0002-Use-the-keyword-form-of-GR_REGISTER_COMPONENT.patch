@@ -236,7 +236,7 @@ endif(ENABLE_AIRSPYHF)
 ########################################################################
 # Setup SoapySDR component
 ########################################################################
-GR_REGISTER_COMPONENT("SoapySDR support" ENABLE_SOAPY SoapySDR_FOUND)
+GR_REGISTER_COMPONENT(NAME "SoapySDR support" VAR ENABLE_SOAPY NO_INSTALL REQUIRED_TPLS SoapySDR_FOUND)
