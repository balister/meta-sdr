     add_subdirectory(rfspace)
 endif(ENABLE_RFSPACE)
@@ -220,7 +220,7 @@ endif(ENABLE_RFSPACE)
 ########################################################################
 # Setup AIRSPY component
 ########################################################################
-GR_REGISTER_COMPONENT("AIRSPY Receiver" ENABLE_AIRSPY LIBAIRSPY_FOUND)
+GR_REGISTER_COMPONENT(NAME "AIRSPY Receiver" VAR ENABLE_AIRSPY NO_INSTALL REQUIRED_TPLS LIBAIRSPY_FOUND)
 if(ENABLE_AIRSPY)
     add_subdirectory(airspy)
 endif(ENABLE_AIRSPY)
@@ -228,7 +228,7 @@ endif(ENABLE_AIRSPY)
 ########################################################################
 # Setup AIRSPYHF component
 ########################################################################
-GR_REGISTER_COMPONENT("AIRSPY HF+ Receiver" ENABLE_AIRSPYHF LIBAIRSPYHF_FOUND)
+GR_REGISTER_COMPONENT(NAME "AIRSPY HF+ Receiver" VAR ENABLE_AIRSPYHF NO_INSTALL REQUIRED_TPLS LIBAIRSPYHF_FOUND)
