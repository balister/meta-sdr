@@ -244,7 +244,7 @@ endif(ENABLE_SOAPY)
 ########################################################################
 # Setup Red Pitaya component
 ########################################################################
-GR_REGISTER_COMPONENT("Red Pitaya SDR" ENABLE_REDPITAYA)
+GR_REGISTER_COMPONENT(NAME "Red Pitaya SDR" VAR ENABLE_REDPITAYA NO_INSTALL)
