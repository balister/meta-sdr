From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Philip Balister <philip@balister.org>
Date: Tue, 17 Nov 2026 10:06:21 -0500
Subject: [PATCH] fix(blocks): install the shared plugin into
 gnuradio-4/plugins

gr4_studio_add_block_plugin() installs the static plugin library into
${CMAKE_INSTALL_LIBDIR}/gnuradio-4/plugins, but the shared plugin into
plain ${CMAKE_INSTALL_LIBDIR}. gr::PluginLoader only scans
gnuradio-4/plugins by default (gnuradio4-core's
GR_INSTALLED_PLUGIN_DIRECTORY), which is also where gnuradio4-blocks
installs its plugins, so an installed Gr4StudioBlocksPlugin was never
found without setting GNURADIO4_PLUGIN_DIRECTORIES.

Install the shared plugin next to the static one.

Upstream-Status: Submitted [https://github.com/gnuradio/gnuradio4-studio/pull/74]

Signed-off-by: Philip Balister <philip@balister.org>
---
 blocks/cmake/PluginHelpers.cmake | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/blocks/cmake/PluginHelpers.cmake b/blocks/cmake/PluginHelpers.cmake
index 18af4ce..2cea937 100644
--- a/blocks/cmake/PluginHelpers.cmake
+++ b/blocks/cmake/PluginHelpers.cmake
@@ -71,6 +71,6 @@ function(gr4_studio_add_block_plugin plugin_target_base)
     set(_plugin_lib_name "${plugin_target_base}Plugin")
     add_library(${_plugin_lib_name} SHARED)
     target_link_libraries(${_plugin_lib_name} PRIVATE ${plugin_target_base})
-    install(TARGETS ${_plugin_lib_name} LIBRARY DESTINATION ${CMAKE_INSTALL_LIBDIR})
+    install(TARGETS ${_plugin_lib_name} LIBRARY DESTINATION ${CMAKE_INSTALL_LIBDIR}/gnuradio-4/plugins)
   endif()
 endfunction()
