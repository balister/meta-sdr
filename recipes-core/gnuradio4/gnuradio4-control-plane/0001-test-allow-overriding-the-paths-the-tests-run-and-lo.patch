From 6e83cccb4642d918826357ab7b0d90a5e35e69af Mon Sep 17 00:00:00 2001
From: Philip Balister <philip@balister.org>
Date: Wed, 4 Nov 2026 07:49:09 -0500
Subject: [PATCH] test: allow overriding the paths the tests run and load

gr4cp_smoke_test, gr4cp_cli_test and gr4cp_core_test have the build-tree
paths of gr4cp_server, gr4cp-cli, the gr4cp_broken_plugin module and
gnuradio-shared-state compiled in. A cross build that installs the tests
to run on the target (Yocto ptest) has none of those paths there, and the
build host paths fail Yocto's buildpaths QA check.

Add a cache variable for each path. Empty, the default, keeps the
build-tree path.

Upstream-Status: Pending
---
 CMakeLists.txt | 15 +++++++++++----
 1 file changed, 11 insertions(+), 4 deletions(-)

diff --git a/CMakeLists.txt b/CMakeLists.txt
index 4b4ab7c..c30fc46 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -22,6 +22,13 @@ set(GR4CP_GNURADIO4_PREFIX "${_gr4cp_default_gnuradio4_prefix}" CACHE PATH "Opti
 set(GR4CP_EXTRA_PLUGIN_DIRECTORIES "" CACHE STRING "Colon-separated plugin directories searched last")
 set(GR4CP_PLUGIN_DIRECTORIES "" CACHE STRING "Colon-separated plugin directories replacing the installation's plugin directory")
 
+# The tests run programs and load libraries by the build-tree paths of their targets. A package that runs the
+# installed tests elsewhere sets these to where those files are installed; empty keeps the build-tree path.
+set(GR4CP_SERVER_TEST_EXECUTABLE "" CACHE FILEPATH "gr4cp_server that gr4cp_smoke_test runs")
+set(GR4CP_CLI_TEST_EXECUTABLE "" CACHE FILEPATH "gr4cp-cli that gr4cp_cli_test runs")
+set(GR4CP_BROKEN_PLUGIN_TEST_LIBRARY "" CACHE FILEPATH "gr4cp_broken_plugin module that gr4cp_core_test loads")
+set(GR4CP_CORE_TEST_LIBRARY "" CACHE FILEPATH "gnuradio-shared-state library that gr4cp_core_test loads")
+
 # Use ccache if found and enabled
 find_program(CCACHE_PROGRAM ccache)
 if(CCACHE_PROGRAM AND USE_CCACHE)
@@ -373,7 +380,7 @@ if(NOT EMSCRIPTEN)
 
     target_compile_definitions(gr4cp_smoke_test
         PRIVATE
-            GR4CP_SERVER_EXECUTABLE="$<TARGET_FILE:gr4cp_server>"
+            GR4CP_SERVER_EXECUTABLE="$<IF:$<BOOL:${GR4CP_SERVER_TEST_EXECUTABLE}>,${GR4CP_SERVER_TEST_EXECUTABLE},$<TARGET_FILE:gr4cp_server>>"
     )
     add_dependencies(gr4cp_smoke_test gr4cp_server)
 
@@ -403,8 +410,8 @@ if(NOT EMSCRIPTEN)
 
     target_compile_definitions(gr4cp_core_test
         PRIVATE
-            GR4CP_BROKEN_PLUGIN_LIBRARY="$<TARGET_FILE:gr4cp_broken_plugin>"
-            GR4CP_CORE_LIBRARY="$<TARGET_FILE:gnuradio4::gnuradio-shared-state>"
+            GR4CP_BROKEN_PLUGIN_LIBRARY="$<IF:$<BOOL:${GR4CP_BROKEN_PLUGIN_TEST_LIBRARY}>,${GR4CP_BROKEN_PLUGIN_TEST_LIBRARY},$<TARGET_FILE:gr4cp_broken_plugin>>"
+            GR4CP_CORE_LIBRARY="$<IF:$<BOOL:${GR4CP_CORE_TEST_LIBRARY}>,${GR4CP_CORE_TEST_LIBRARY},$<TARGET_FILE:gnuradio4::gnuradio-shared-state>>"
             GR4CP_PLUGIN_DIRECTORIES="${GR4CP_PLUGIN_DIRECTORIES}"
     )
     add_dependencies(gr4cp_core_test gr4cp_broken_plugin)
@@ -453,7 +460,7 @@ if(NOT EMSCRIPTEN)
 
     target_compile_definitions(gr4cp_cli_test
         PRIVATE
-            GR4CP_CLI_EXECUTABLE="$<TARGET_FILE:gr4cp_cli_exec>"
+            GR4CP_CLI_EXECUTABLE="$<IF:$<BOOL:${GR4CP_CLI_TEST_EXECUTABLE}>,${GR4CP_CLI_TEST_EXECUTABLE},$<TARGET_FILE:gr4cp_cli_exec>>"
     )
 
     gtest_discover_tests(gr4cp_cli_test)
