#!/bin/sh
# Run the gnuradio4-core unit tests (boost-ext-ut binaries built by
# -DENABLE_TESTING=ON) and report results in the PASS/FAIL format
# ptest-runner expects.
#
# These are run directly rather than through ctest/CTestTestfile.cmake:
# CTest's relative-path executable lookup does not resolve against the
# invoking directory, so a CTestTestfile.cmake copied out of the build tree
# can no longer find its test binaries once ${B} is stripped out of it.

RET=0

for t in core/test/qa_* meta/test/qa_*; do
    [ -x "$t" ] || continue
    name=$(basename "$t")
    [ "$name" = qa_PluginGlobalDefault ] && continue
    if "./$t"; then
        echo "PASS: $name"
    else
        echo "FAIL: $name"
        RET=1
    fi
done

# qa_PluginGlobalDefault checks the loader's default plugin directory,
# ../plugins relative to where it runs, so like ctest run it in the empty
# global_default_cwd next to core/test/plugins, with
# GNURADIO4_PLUGIN_DIRECTORIES unset.
if [ -x core/test/qa_PluginGlobalDefault ]; then
    if (cd core/test/global_default_cwd && unset GNURADIO4_PLUGIN_DIRECTORIES && ../qa_PluginGlobalDefault); then
        echo "PASS: qa_PluginGlobalDefault"
    else
        echo "FAIL: qa_PluginGlobalDefault"
        RET=1
    fi
fi

exit $RET
