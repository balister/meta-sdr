From 7910eb766e595b87b96b51a5f046d823719c4aab Mon Sep 17 00:00:00 2001
From: Philip Balister <philip@opensdr.com>
Date: Sat, 29 Aug 2026 17:51:54 -0400
Subject: [PATCH] bench: do not use -march=native when cross-compiling

append_compiler_flags() (bench/CMakeLists.txt) and add_gr_benchmark()
(core/benchmarks/CMakeLists.txt) unconditionally pass -march=native to
every non-Emscripten benchmark target. Under cross-compilation the
target compiler only accepts -march=armv8-a[.N]; 'native' is rejected
outright, breaking any cross build that has ENABLE_TESTING (which
implicitly enables the bench targets via add_subdirectory(bench),
unconditional in the top-level CMakeLists.txt) or benchmarks turned on.

Skip the -march=native flag when CMAKE_CROSSCOMPILING, same as is
already done for EMSCRIPTEN.

Upstream-Status: Pending

Signed-off-by: Philip Balister <philip@balister.org>
---
 bench/CMakeLists.txt           | 2 +-
 core/benchmarks/CMakeLists.txt | 2 +-
 2 files changed, 2 insertions(+), 2 deletions(-)

diff --git a/bench/CMakeLists.txt b/bench/CMakeLists.txt
index 51047c8..591cba0 100644
--- a/bench/CMakeLists.txt
+++ b/bench/CMakeLists.txt
@@ -7,7 +7,7 @@ install(FILES ${CMAKE_CURRENT_SOURCE_DIR}/benchmark.hpp DESTINATION ${CMAKE_INST
 
 function(append_compiler_flags TARGET_NAME)
   set(FLAGS_COMMON -Wall)
-  if(EMSCRIPTEN)
+  if(EMSCRIPTEN OR CMAKE_CROSSCOMPILING)
     set(FLAGS_SPECIAL "")
   else()
     set(FLAGS_SPECIAL -march=native)
diff --git a/core/benchmarks/CMakeLists.txt b/core/benchmarks/CMakeLists.txt
index 9e0a82e..02114ee 100644
--- a/core/benchmarks/CMakeLists.txt
+++ b/core/benchmarks/CMakeLists.txt
@@ -9,7 +9,7 @@ if(NOT EMSCRIPTEN)
               gnuradio-plugin
               ut
               ut-benchmark)
-    if(EMSCRIPTEN) # performance benchmarks should be optimised
+    if(EMSCRIPTEN OR CMAKE_CROSSCOMPILING) # performance benchmarks should be optimised
       target_compile_options(${BM_NAME} PRIVATE -O3)
     else()
       target_compile_options(${BM_NAME} PRIVATE -O3 -march=native)
-- 
