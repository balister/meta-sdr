From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Philip Balister <philip@balister.org>
Date: Mon, 16 Nov 2026 17:39:38 -0500
Subject: [PATCH] sdr: the Soapy tests read their module directory and empty
 root from the environment

qa_SoapySource, qa_SoapyRaiiWrapper and qa_SoapyIntegration compiled in
the build-tree paths of soapy_modules and soapy_empty_root as
GR_SDR_TEST_SOAPY_MODULE_DIR and GR_SDR_TEST_SOAPY_EMPTY_ROOT. A test
binary installed apart from the build tree, such as a packaged test run
on a cross-compiled target, then looked for the loopback module in a
directory that does not exist there, and carried the build host's
paths.

ctest now passes the two directories in each test's ENVIRONMENT, next
to SOAPY_SDR_ROOT and SOAPY_SDR_PLUGIN_PATH, as the tool and control
plane tests do with their paths. The tests read them through
SoapyTestEnvironment.hpp, which stops a confined run and names the
variable when one is unset. A hardware run of qa_SoapyIntegration
(GR_SDR_TEST_HARDWARE=1) adds the loopback directory only when the
variable is set. Run through ctest in the build tree, every test sees
the directories it saw before.

Upstream-Status: Pending

Signed-off-by: Philip Balister <philip@balister.org>
---
 blocks/sdr/test/CMakeLists.txt           | 19 ++++++++--------
 blocks/sdr/test/SoapyTestEnvironment.hpp | 29 ++++++++++++++++++++++++
 blocks/sdr/test/qa_SoapyIntegration.cpp  | 13 +++++++----
 blocks/sdr/test/qa_SoapyRaiiWrapper.cpp  |  8 ++++---
 blocks/sdr/test/qa_SoapySource.cpp       |  8 ++++---
 5 files changed, 57 insertions(+), 20 deletions(-)
 create mode 100644 blocks/sdr/test/SoapyTestEnvironment.hpp

diff --git a/blocks/sdr/test/CMakeLists.txt b/blocks/sdr/test/CMakeLists.txt
index 5fdcfd8..802fe6c 100644
--- a/blocks/sdr/test/CMakeLists.txt
+++ b/blocks/sdr/test/CMakeLists.txt
@@ -64,12 +64,15 @@ if(TARGET SoapySDR)
   add_test(NAME qa_SoapySource COMMAND ${CMAKE_CROSSCOMPILING_EMULATOR} ${CMAKE_CURRENT_BINARY_DIR}/qa_SoapySource)
   # SoapySDR loads the loopback module alone. SOAPY_SDR_ROOT names an empty directory in place of the host's module
   # folders, and SOAPY_SDR_PLUGIN_PATH names the loopback module's directory. The program sets both itself unless
-  # GR_SDR_TEST_HARDWARE=1 asks for the host's modules and radios.
+  # GR_SDR_TEST_HARDWARE=1 asks for the host's modules and radios. It reads the two directories from
+  # GR_SDR_TEST_SOAPY_MODULE_DIR and GR_SDR_TEST_SOAPY_EMPTY_ROOT in its environment, so the binary carries no build-tree
+  # path and a test installed elsewhere runs with the directories its runner names.
   set(SOAPY_MODULE_DIR ${CMAKE_CURRENT_BINARY_DIR}/soapy_modules)
   set(SOAPY_EMPTY_ROOT ${CMAKE_CURRENT_BINARY_DIR}/soapy_empty_root)
   file(MAKE_DIRECTORY ${SOAPY_EMPTY_ROOT})
-  target_compile_definitions(qa_SoapySource PRIVATE GR_SDR_TEST_SOAPY_MODULE_DIR="${SOAPY_MODULE_DIR}"
-                                                    GR_SDR_TEST_SOAPY_EMPTY_ROOT="${SOAPY_EMPTY_ROOT}")
+  set(SOAPY_TEST_ENVIRONMENT
+      "GR_SDR_TEST_SOAPY_MODULE_DIR=${SOAPY_MODULE_DIR};GR_SDR_TEST_SOAPY_EMPTY_ROOT=${SOAPY_EMPTY_ROOT};SOAPY_SDR_ROOT=${SOAPY_EMPTY_ROOT};SOAPY_SDR_PLUGIN_PATH=${SOAPY_MODULE_DIR}"
+  )
   if(SOAPY_CXX_ABI_COMPATIBLE)
     add_dependencies(qa_SoapySource gr-sdr-loopback)
     add_custom_command(
@@ -86,7 +89,7 @@ if(TARGET SoapySDR)
     qa_SoapySource
     PROPERTIES
       ENVIRONMENT
-      "SOAPY_SDR_ROOT=${SOAPY_EMPTY_ROOT};SOAPY_SDR_PLUGIN_PATH=${SOAPY_MODULE_DIR};ASAN_OPTIONS=detect_leaks=0")
+      "${SOAPY_TEST_ENVIRONMENT};ASAN_OPTIONS=detect_leaks=0")
 
   # includes a filter block header before the sdr headers, so it compiles only while the sdr headers name every kernel
   # of gr::filter in full. No device is opened.
@@ -163,13 +166,11 @@ if(TARGET SoapySDR)
     add_test(NAME qa_SoapyRaiiWrapper COMMAND ${CMAKE_CROSSCOMPILING_EMULATOR}
                                               ${CMAKE_CURRENT_BINARY_DIR}/qa_SoapyRaiiWrapper)
     # loads the loopback module alone, as qa_SoapySource does. It names no other driver.
-    target_compile_definitions(qa_SoapyRaiiWrapper PRIVATE GR_SDR_TEST_SOAPY_MODULE_DIR="${SOAPY_MODULE_DIR}"
-                                                           GR_SDR_TEST_SOAPY_EMPTY_ROOT="${SOAPY_EMPTY_ROOT}")
     set_tests_properties(
       qa_SoapyRaiiWrapper
       PROPERTIES
         ENVIRONMENT
-        "SOAPY_SDR_ROOT=${SOAPY_EMPTY_ROOT};SOAPY_SDR_PLUGIN_PATH=${SOAPY_MODULE_DIR};ASAN_OPTIONS=detect_leaks=0")
+        "${SOAPY_TEST_ENVIRONMENT};ASAN_OPTIONS=detect_leaks=0")
     # GR4 integration test: SoapySource + loopback through scheduler
     add_executable(qa_SoapyIntegration qa_SoapyIntegration.cpp)
     target_link_libraries(
@@ -193,13 +194,11 @@ if(TARGET SoapySDR)
                                               ${CMAKE_CURRENT_BINARY_DIR}/qa_SoapyIntegration)
     # The test loads the loopback module alone, as qa_SoapySource does. Its LimeSDR cases run only in a direct run with
     # GR_SDR_TEST_HARDWARE=1.
-    target_compile_definitions(qa_SoapyIntegration PRIVATE GR_SDR_TEST_SOAPY_MODULE_DIR="${SOAPY_MODULE_DIR}"
-                                                           GR_SDR_TEST_SOAPY_EMPTY_ROOT="${SOAPY_EMPTY_ROOT}")
     set_tests_properties(
       qa_SoapyIntegration
       PROPERTIES
         ENVIRONMENT
-        "SOAPY_SDR_ROOT=${SOAPY_EMPTY_ROOT};SOAPY_SDR_PLUGIN_PATH=${SOAPY_MODULE_DIR};ASAN_OPTIONS=detect_leaks=0")
+        "${SOAPY_TEST_ENVIRONMENT};ASAN_OPTIONS=detect_leaks=0")
     # SoapySink's transmit burst tags against the loopback module, which records the flags and time of every write.
     # Every case names the loopback driver alone.
     add_executable(qa_SoapySinkBurst qa_SoapySinkBurst.cpp)
diff --git a/blocks/sdr/test/SoapyTestEnvironment.hpp b/blocks/sdr/test/SoapyTestEnvironment.hpp
new file mode 100644
index 0000000..cfc3f19
--- /dev/null
+++ b/blocks/sdr/test/SoapyTestEnvironment.hpp
@@ -0,0 +1,29 @@
+#ifndef GNURADIO_SDR_TEST_SOAPY_TEST_ENVIRONMENT_HPP
+#define GNURADIO_SDR_TEST_SOAPY_TEST_ENVIRONMENT_HPP
+
+#include <cstdlib>
+#include <format>
+#include <stdexcept>
+#include <string>
+
+// The loopback module's directory and the empty SoapySDR root reach the test through its environment: ctest sets
+// GR_SDR_TEST_SOAPY_MODULE_DIR and GR_SDR_TEST_SOAPY_EMPTY_ROOT (see CMakeLists.txt), and a packaged test's runner sets
+// them to where it installed the two directories. The test binary carries no path of the tree it was built in.
+
+// A directory the run names through the test's environment. Without it the test cannot confine SoapySDR to the loopback
+// module, so it stops and names the variable.
+[[nodiscard]] inline std::string soapyTestDirectory(const char* variable) {
+    const char* value = std::getenv(variable);
+    if (value == nullptr || *value == '\0') {
+        throw std::runtime_error(std::format("the environment variable {} is not set or empty; run the test through ctest", variable));
+    }
+    return value;
+}
+
+// the directory holding the loopback module, gr-sdr-loopback
+[[nodiscard]] inline std::string soapyModuleDirectory() { return soapyTestDirectory("GR_SDR_TEST_SOAPY_MODULE_DIR"); }
+
+// an empty directory that stands in for SoapySDR's installation root, so that none of the host's modules load
+[[nodiscard]] inline std::string soapyEmptyRoot() { return soapyTestDirectory("GR_SDR_TEST_SOAPY_EMPTY_ROOT"); }
+
+#endif // GNURADIO_SDR_TEST_SOAPY_TEST_ENVIRONMENT_HPP
diff --git a/blocks/sdr/test/qa_SoapyIntegration.cpp b/blocks/sdr/test/qa_SoapyIntegration.cpp
index ff25bed..43dcfd4 100644
--- a/blocks/sdr/test/qa_SoapyIntegration.cpp
+++ b/blocks/sdr/test/qa_SoapyIntegration.cpp
@@ -28,6 +28,8 @@
 #include <gnuradio-4.0/testing/NullSources.hpp>
 #include <gnuradio-4.0/testing/TagMonitors.hpp>
 
+#include "SoapyTestEnvironment.hpp"
+
 using namespace boost::ut;
 using CF32 = std::complex<float>;
 
@@ -85,13 +87,16 @@ bool hardwareRequested() {
 
 /// Without GR_SDR_TEST_HARDWARE=1, SOAPY_SDR_ROOT names an empty directory and SOAPY_SDR_PLUGIN_PATH the loopback
 /// module's directory. SoapySDR then loads the loopback module alone. With it, the loopback module's directory joins the
-/// host's module folders unless SOAPY_SDR_PLUGIN_PATH is set. The flag is initialized ahead of the suites below.
+/// host's module folders unless SOAPY_SDR_PLUGIN_PATH is set, or GR_SDR_TEST_SOAPY_MODULE_DIR is not. The flag is
+/// initialized ahead of the suites below.
 const bool kHardwareRequested = [] {
     const bool requested = hardwareRequested();
     if (!requested) {
-        setenv("SOAPY_SDR_ROOT", GR_SDR_TEST_SOAPY_EMPTY_ROOT, 1);
+        setenv("SOAPY_SDR_ROOT", soapyEmptyRoot().c_str(), 1);
+        setenv("SOAPY_SDR_PLUGIN_PATH", soapyModuleDirectory().c_str(), 1);
+    } else if (const char* moduleDirectory = std::getenv("GR_SDR_TEST_SOAPY_MODULE_DIR"); moduleDirectory != nullptr) {
+        setenv("SOAPY_SDR_PLUGIN_PATH", moduleDirectory, 0);
     }
-    setenv("SOAPY_SDR_PLUGIN_PATH", GR_SDR_TEST_SOAPY_MODULE_DIR, requested ? 0 : 1);
     return requested;
 }();
 
@@ -348,7 +353,7 @@ const boost::ut::suite<"SoapySDR modules"> moduleTests = [] {
         const std::vector<std::string> modules = soapy::getSoapySDRModules();
         expect(!modules.empty()) << "the loopback module is listed";
         for (const auto& module : modules) {
-            expect(module.starts_with(GR_SDR_TEST_SOAPY_MODULE_DIR "/")) << module;
+            expect(module.starts_with(soapyModuleDirectory() + "/")) << module;
         }
     };
 };
