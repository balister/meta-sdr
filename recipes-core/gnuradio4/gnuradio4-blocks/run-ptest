#!/bin/sh
# Run the gnuradio4-blocks unit tests (boost-ext-ut / plain-main binaries
# built by the upstream default -DENABLE_TESTING=ON) and report results in
# the PASS/FAIL format ptest-runner expects.
#
# These are run directly rather than through ctest/CTestTestfile.cmake:
# CTest's relative-path executable lookup does not resolve against the
# invoking directory, so a CTestTestfile.cmake copied out of the build tree
# can no longer find its test binaries once ${B} is stripped out of it.

RET=0

# qa_KnownSharedLibBlocks links directly against the per-block Shared .so's
# (libGrTestingBlocksShared.so etc), which are installed under
# /usr/lib/gnuradio-4/plugins/ for gr::PluginLoader's dlopen() scanning
# rather than under the ld.so default search path, so the dynamic linker
# can't resolve them at process startup without help.
export LD_LIBRARY_PATH="/usr/lib/gnuradio-4/plugins${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"

export GNURADIO4_PLUGIN_DIRECTORIES=/usr/lib/gnuradio-4/plugins/
export SOAPY_SDR_PLUGIN_PATH=/usr/lib/gnuradio4-blocks/ptest/blocks/sdr/test/soapy_modules/
export DISABLE_SENSITIVE_TESTS=1

for t in library/algorithm/test/qa_* blocks/*/test/qa_*; do
    [ -x "$t" ] || continue
    name=$(basename "$t")
    if "./$t"; then
        echo "PASS: $name"
    else
        echo "FAIL: $name"
        RET=1
    fi
done

# The graph-file cases ctest runs through core's rungraph
# (gr_add_graph_test()), listed in graph-tests.sh by do_install_ptest.
# rungraph finds every installed plugin rather than the few ctest names; the
# environment above covers it. A case passes when rungraph exits with 0
# (pass), exits nonzero (fail), or prints a line matching the pattern
# (match; ctest ignores the exit status there). `timeout` isn't in this
# image, so a watchdog kills a case that runs past its ctest timeout, given
# four times the time under qemu's TCG.
out=$(mktemp)
graph_test() {
    name=$1 expect=$2 limit=$(($3 * 4)) pattern=$4
    shift 4
    rungraph "$@" >"$out" 2>&1 &
    pid=$!
    (
        sleep "$limit" &
        trap 'kill $!; exit' TERM
        wait $!
        kill -9 "$pid"
    ) >/dev/null 2>&1 &
    watchdog=$!
    wait "$pid"
    rc=$?
    kill "$watchdog" 2>/dev/null
    wait "$watchdog" 2>/dev/null
    case $expect in
    pass) [ "$rc" -eq 0 ] ;;
    fail) [ "$rc" -ne 0 ] && [ "$rc" -ne 137 ] ;;
    match) grep -qE -e "$pattern" "$out" ;;
    esac
    if [ $? -eq 0 ]; then
        echo "PASS: $name"
    else
        echo "FAIL: $name (rungraph exited $rc)"
        tail -n 20 "$out"
        RET=1
    fi
}
[ -f graph-tests.sh ] && . ./graph-tests.sh
rm -f "$out"

exit $RET
