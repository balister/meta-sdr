From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Philip Balister <philip@balister.org>
Date: Tue, 17 Nov 2026 08:02:01 -0500
Subject: [PATCH] gr-blocks: qa_wavfile finds its test files without srcdir

qa_wavfile reads its .wav and .mp3 inputs from $srcdir, which ctest sets
to the test's source directory. Run any other way, such as from an
installed test package, os.getenv("srcdir") is None and the test fails
in os.path.join before any case runs.

Fall back to the directory of the script, where the files are kept.

Upstream-Status: Submitted [https://github.com/gnuradio/gnuradio/pull/8281]

Signed-off-by: Philip Balister <philip@balister.org>
---
 gr-blocks/python/blocks/qa_wavfile.py | 11 ++++++-----
 1 file changed, 6 insertions(+), 5 deletions(-)

diff --git a/gr-blocks/python/blocks/qa_wavfile.py b/gr-blocks/python/blocks/qa_wavfile.py
index 62f4a1e..b50614c 100644
--- a/gr-blocks/python/blocks/qa_wavfile.py
+++ b/gr-blocks/python/blocks/qa_wavfile.py
@@ -17,11 +17,12 @@ import tempfile
 import wave
 from os.path import getsize
 
-g_in_file = os.path.join(os.getenv("srcdir"), "test_16bit_1chunk.wav")
-g_in_file_normal = os.path.join(
-    os.getenv("srcdir"),
-    "test_16bit_1chunk_normal.wav")
-g_in_file_mp3 = os.path.join(os.getenv("srcdir"), "test_no_info_frame.mp3")
+# The test files sit next to this script. ctest sets srcdir to the same
+# directory; a test run without ctest falls back to the script's directory.
+g_srcdir = os.getenv("srcdir", os.path.dirname(os.path.abspath(__file__)))
+g_in_file = os.path.join(g_srcdir, "test_16bit_1chunk.wav")
+g_in_file_normal = os.path.join(g_srcdir, "test_16bit_1chunk_normal.wav")
+g_in_file_mp3 = os.path.join(g_srcdir, "test_no_info_frame.mp3")
 g_extra_header_offset = 36
 g_extra_header_len = 22
 
-- 
2.56.1

